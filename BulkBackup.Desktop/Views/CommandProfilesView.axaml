<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:BulkBackup.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="780"
             x:Class="BulkBackup.Desktop.Views.CommandProfilesView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16,14,16,14">
        <!-- Top Bar: Cohesive Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Margin="0,0,0,12" Padding="14"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <DockPanel>
                <!-- Left: Label, ComboBox, Count badge -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CLI Command Profile:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox SelectedIndex="{Binding SelectedProfileIndex}" Width="320" VerticalAlignment="Center">
                        <ComboBoxItem Content="Cisco Switch (IOS / IOS-XE)"/>
                        <ComboBoxItem Content="Cisco Nexus Switch (NX-OS)"/>
                        <ComboBoxItem Content="Cisco Catalyst 9800 WLC (IOS-XE)"/>
                        <ComboBoxItem Content="Cisco AireOS WLC (5520 / 8540 / 3504)"/>
                        <ComboBoxItem Content="Custom CLI Command Script"/>
                    </ComboBox>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CommandCount, StringFormat='{}{0} Commands'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Right: Reset & Clear buttons -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ResetProfileCommandsCommand}" Height="32" Margin="0,0,8,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Refresh" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Reset Template" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearCommandsCommand}" Height="32" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Clear" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Custom Commands Editor Area -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="CLI Commands to execute per target (One per line; lines starting with '!' are comments):"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                <TextBox Grid.Row="1" Text="{Binding CustomCommandsText}"
                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                         Padding="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
