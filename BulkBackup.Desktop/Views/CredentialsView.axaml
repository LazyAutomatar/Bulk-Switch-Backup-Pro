<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:BulkBackup.Desktop.ViewModels"
             xmlns:models="using:BulkBackup.Core.Models"
             mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="780"
             x:Class="BulkBackup.Desktop.Views.CredentialsView"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="380,*" Margin="16,14,16,14">
        <!-- Left Card: Add Credential Form -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Margin="0,0,14,0" Padding="18"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <ui:SymbolIcon Symbol="Permissions" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Save Credential Preset" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Profile Name (Label):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewCredProfileName}" Watermark="e.g. Core Switches, NOC Fallback" Margin="0,0,0,10"/>

                <TextBlock Text="SSH Username:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewCredUsername}" Watermark="admin / netadmin" Margin="0,0,0,10"/>

                <TextBlock Text="SSH Password:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewCredPassword}" PasswordChar="*" Watermark="••••••••" Margin="0,0,0,10"/>

                <TextBlock Text="Enable Secret (Optional):" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewCredSecret}" PasswordChar="*" Watermark="Optional enable secret" Margin="0,0,0,16"/>

                <!-- DPAPI Security Status Indicator -->
                <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,14"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Accept" FontSize="15" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="DPAPI Encryption Active — Windows CurrentUser"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Classes="accent"
                        Command="{Binding SaveNewCredentialCommand}"
                        HorizontalAlignment="Stretch" Height="38" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Save Credential" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <TextBlock Text="Note: Storing credentials here is completely optional. Saved credentials can be applied to the active session with one click, or used as automatic failover."
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Right Card: Saved Credentials Table -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Margin="0,0,0,12" Padding="14"
                    HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Saved Credentials Pool" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Manage pre-configured credentials to quickly apply them to your session or allow the backup engine to test them sequentially if the primary login fails."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Empty State Card -->
            <Border Grid.Row="1" IsVisible="{Binding !HasStoredCredentials}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Permissions" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="No Saved Credentials" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Save credentials on the left to quickly apply them or use them for automated multi-credential failover."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="1" ItemsSource="{Binding StoredCredentials}" AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding HasStoredCredentials}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Profile Name" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Secret Configured" Binding="{Binding Secret, TargetNullValue='No'}" Width="140"/>
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:CredentialEntry">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Apply to Session"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyCredentialToActiveCommand}"
                                            CommandParameter="{Binding}"
                                            Height="26" Padding="8,0" Margin="0,0,6,0" Cursor="Hand"/>
                                    <Button Content="Delete"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteStoredCredentialCommand}"
                                            CommandParameter="{Binding}"
                                            Height="26" Padding="8,0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

