<Window x:Class="BulkSwitchBackupPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BulkSwitchBackupPro"
        mc:Ignorable="d"
        Title="Bulk Switch Backup Pro - Enterprise Network Automation"
        Height="840" Width="1400"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#D4D4D4" FontFamily="Segoe UI" FontSize="12">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/> <!-- Application Top Bar -->
            <RowDefinition Height="*"/>  <!-- Workspace -->
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- TOP APP BAR                                             -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bulk Switch Backup Pro" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                    <Border Background="#2D2D32" CornerRadius="2" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Enterprise Edition" FontSize="10" Foreground="#007ACC" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Backups Folder" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource DesktopButton}" Height="24" Padding="10,2" Margin="0,0,6,0" FontSize="11"/>
                    <Button Content="Export ZIP Archive..." Command="{Binding ExportZipCommand}" Style="{StaticResource DesktopButton}" Height="24" Padding="10,2" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN WORKSPACE                                          -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/> <!-- Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Right Monitor -->
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- COLUMN 0: SIDEBAR (TABS + ACTION DOCK)                  -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#2D2D30" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="0">
                        <!-- TAB 1: TARGETS & SETUP -->
                        <TabItem Header="Targets &amp; Setup">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="14,12,14,14">

                                    <!-- SECTION: TARGET DEVICES -->
                                    <TextBlock Text="TARGET DEVICES" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,4"/>
                                    <TextBlock Text="Seed switch IP addresses (one per line):" FontSize="11" Foreground="#777777" Margin="0,0,0,6"/>
                                    <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6">
                                        <TextBox Text="{Binding TargetIps, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" Height="82" FontFamily="Consolas" FontSize="11.5"
                                                 Background="Transparent" BorderThickness="0" Padding="6,4"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                    <Button Content="Import Devices from File (TXT/CSV)..." Command="{Binding ImportDevicesCommand}" Style="{StaticResource DesktopButton}" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                                    <Rectangle Height="1" Fill="#2D2D30" Margin="0,0,0,12"/>

                                    <!-- SECTION: PRIMARY SSH CREDENTIALS -->
                                    <TextBlock Text="PRIMARY SSH CREDENTIALS" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,8"/>

                                    <TextBlock Text="Username" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Password" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                            <PasswordBox x:Name="PasswordBox"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Enable Secret (Optional)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                            <PasswordBox x:Name="SecretBox"/>
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#2D2D30" Margin="0,0,0,12"/>

                                    <!-- SECTION: CDP DISCOVERY -->
                                    <TextBlock Text="CDP AUTO-DISCOVERY" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,8"/>
                                    <CheckBox Content="Enable Recursive CDP Traversal" IsChecked="{Binding EnableCdp}" Margin="0,0,0,8"/>

                                    <StackPanel IsEnabled="{Binding EnableCdp}" Margin="16,0,0,10">
                                        <TextBlock Text="Scope Filter" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox SelectedIndex="{Binding FilterTypeIndex}">
                                                <ComboBoxItem Content="Subnet CIDR"/>
                                                <ComboBoxItem Content="VLAN ID"/>
                                            </ComboBox>
                                            <TextBox Grid.Column="2" Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 10.22.36.0/24 or 10.22."/>
                                        </Grid>
                                        <CheckBox Content="Include Access Points (APs)" IsChecked="{Binding IncludeAps}" Margin="0,0,0,4"/>
                                        <TextBlock Text="* IP Phones are automatically detected and excluded from SSH." FontSize="10.5" Foreground="#6A9955"/>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="#2D2D30" Margin="0,0,0,12"/>

                                    <!-- SECTION: PERFORMANCE -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CONCURRENT WORKERS" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MaxConcurrency, StringFormat='{}{0} threads'}" FontWeight="SemiBold" Foreground="#007ACC" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="10" Maximum="500" Value="{Binding MaxConcurrency}" TickFrequency="10" IsSnapToTickEnabled="True"/>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: CREDENTIALS VAULT (DPAPI) -->
                        <TabItem Header="Credentials Vault">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="14,12,14,14">
                                    <TextBlock Text="STORED CREDENTIALS (WINDOWS DPAPI)" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,4"/>
                                    <TextBlock Text="If a switch/AP fails with the primary credential, the engine will automatically try each credential stored here in sequence." TextWrapping="Wrap" FontSize="11" Foreground="#858585" Margin="0,0,0,10"/>

                                    <!-- Stored Credentials List -->
                                    <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Margin="0,0,0,14" MinHeight="90" MaxHeight="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding StoredCredentials}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#252528" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="8,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                                                                        <TextBlock Text=" (" FontSize="11" Foreground="#777777"/>
                                                                        <TextBlock Text="{Binding Username}" FontSize="11" Foreground="#9CDCFE"/>
                                                                        <TextBlock Text=")" FontSize="11" Foreground="#777777"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding MaskedPassword}" FontSize="10" Foreground="#666666" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="Delete" Command="{Binding DataContext.DeleteStoredCredentialCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DesktopButton}" Height="22" Padding="8,1" FontSize="10.5"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Add New Credential Form -->
                                    <TextBlock Text="ADD CREDENTIAL TO VAULT" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,8"/>

                                    <TextBlock Text="Profile / Host Tag (e.g. Cisco Site Core)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewCredProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Username" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding NewCredUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Password" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewCredPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Enable Secret (Optional)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewCredSecret, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="+ Save Credential to Vault (DPAPI)" Command="{Binding SaveNewCredentialCommand}" Style="{StaticResource DesktopButton}" HorizontalAlignment="Stretch" Height="28"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: CLI COMMANDS & PROFILES -->
                        <TabItem Header="CLI Commands">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="14,12,14,14">

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DEVICE PROFILE" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CommandCount, StringFormat='{}{0} commands'}" FontSize="11" Foreground="#4EC9B0" FontWeight="SemiBold"/>
                                    </Grid>

                                    <ComboBox SelectedIndex="{Binding SelectedProfileIndex}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Cisco Switch (IOS / IOS-XE Standard)"/>
                                        <ComboBoxItem Content="Cisco Nexus Switch (NX-OS)"/>
                                        <ComboBoxItem Content="Custom Command Profile"/>
                                    </ComboBox>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Reset Default" Command="{Binding ResetProfileCommandsCommand}" Style="{StaticResource DesktopButton}"/>
                                        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommandsCommand}" Style="{StaticResource DesktopButton}"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#2D2D30" Margin="0,0,0,12"/>

                                    <TextBlock Text="EXECUTION SEQUENCE" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,6"/>
                                    <Border Background="#181818" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6">
                                        <TextBox Text="{Binding CustomCommandsText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" Height="260"
                                                 FontFamily="Consolas" FontSize="11.5" Foreground="#9CDCFE"
                                                 Background="Transparent" BorderThickness="0" Padding="6,4"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                    </Border>
                                    <TextBlock Text="Commands run sequentially. Lines starting with '!' are comments." FontSize="11" Foreground="#6A9955" Margin="0,0,0,14"/>

                                    <Rectangle Height="1" Fill="#2D2D30" Margin="0,0,0,12"/>

                                    <TextBlock Text="POST-BACKUP OPTIONS" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" Margin="0,0,0,8"/>
                                    <CheckBox Content="Save Configuration (write memory)" IsChecked="{Binding WriteConfig}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Commits running config to NVRAM before session close." FontSize="11" Foreground="#777777" Margin="23,0,0,0"/>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- BOTTOM ACTION DOCK -->
                    <Border Grid.Row="1" Background="#202022" BorderBrush="#2D2D30" BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Button Content="Start Bulk Backup" Command="{Binding StartBackupCommand}" Height="32" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Cancel Execution" Command="{Binding CancelBackupCommand}" Height="32" FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- COLUMN 1: LIVE MONITOR & TERMINAL                       -->
            <!-- ======================================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>  <!-- Metrics Bar -->
                    <RowDefinition Height="5*"/>  <!-- Live Table -->
                    <RowDefinition Height="4"/>   <!-- Splitter -->
                    <RowDefinition Height="4*"/>  <!-- Console -->
                </Grid.RowDefinitions>

                <!-- STATUS & METRICS STRIP -->
                <Border Grid.Row="0" Background="#252526" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Targets:" Foreground="#858585" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding TotalDevicesCount}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" Margin="0,0,16,0"/>

                            <TextBlock Text="In Progress:" Foreground="#858585" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding InProgressDevicesCount}" FontWeight="Bold" Foreground="#569CD6" FontSize="11" Margin="0,0,16,0"/>

                            <TextBlock Text="Completed:" Foreground="#858585" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CompletedDevicesCount}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="11" Margin="0,0,16,0"/>

                            <TextBlock Text="Failed:" Foreground="#858585" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding FailedDevicesCount}" FontWeight="Bold" Foreground="#F48771" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LIVE DEVICE MONITOR (TABLE LIST) -->
                <Grid Grid.Row="1" Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DEVICE / HOSTNAME" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585"/>
                            <TextBlock Grid.Column="1" Text="TYPE" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585"/>
                            <TextBlock Grid.Column="2" Text="CURRENT ACTIVITY" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585"/>
                            <TextBlock Grid.Column="3" Text="PROGRESS" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585"/>
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Rows List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1" Padding="14,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#252528"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 0: IP & Hostname -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Hostname}" FontSize="11" Foreground="#9CDCFE"/>
                                            </StackPanel>

                                            <!-- Column 1: Type Pill -->
                                            <Border Grid.Column="1" Background="#2D2D32" CornerRadius="2" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceType}" FontSize="10" Foreground="#AAAAAA"/>
                                            </Border>

                                            <!-- Column 2: Activity / Status -->
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#CCCCCC" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <!-- Column 3: Progress Bar + Percent -->
                                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Height="4" Background="#333337" CornerRadius="2" ClipToBounds="True">
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="#007ACC"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="10.5" Foreground="#858585" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Column 4: Status Badge -->
                                            <Border Grid.Column="4" Background="{Binding StatusColor}" CornerRadius="2" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="58">
                                                <TextBlock Text="{Binding Protocol}" Foreground="{Binding StatusTextColor}" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- SPLITTER -->
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#2D2D30" ResizeDirection="Rows"/>

                <!-- EXECUTION CONSOLE -->
                <Grid Grid.Row="3" Background="#181818">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#222224" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DIAGNOSTIC OUTPUT &amp; LOGS" FontSize="10.5" FontWeight="SemiBold" Foreground="#858585" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Copy" Command="{Binding CopyLogsCommand}" Style="{StaticResource DesktopButton}" Height="20" Padding="8,1" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource DesktopButton}" Height="20" Padding="8,1" FontSize="10.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="1" x:Name="LogTextBox" Text="{Binding Logs, Mode=OneWay}"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#181818" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="11.5"
                             BorderThickness="0" Padding="10,6" Height="NaN"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
