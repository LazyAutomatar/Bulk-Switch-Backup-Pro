<ui:FluentWindow x:Class="BulkBackup.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BulkBackup.App.ViewModels"
        xmlns:conv="clr-namespace:BulkBackup.App.Converters"
        mc:Ignorable="d"
        Title="Bulk Switch Backup Pro"
        Height="860" Width="1400" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Title Bar -->
            <RowDefinition Height="*" />    <!-- Main Body Workspace -->
        </Grid.RowDefinitions>

        <!-- Window Title Bar with Theme Toggle matching Network Health Reporter -->
        <Grid Grid.Row="0">
            <ui:TitleBar Title="Bulk Switch Backup Pro" CloseWindowByDoubleClickOnIcon="True">
                <ui:TitleBar.TrailingContent>
                    <ui:Button Appearance="Secondary" 
                               Padding="10,3"
                               Cursor="Hand"
                               Margin="0,0,16,0"
                               Command="{Binding ToggleThemeCommand}"
                               ToolTip="Switch between Dark and Light Mode">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding ThemeSymbol}" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="{Binding ThemeButtonText}" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <!-- Animated Header Activity Glow Bar (Active while backup engine is running) -->
            <ProgressBar VerticalAlignment="Bottom" Height="3" Minimum="0" Maximum="100" 
                         Value="{Binding OverallProgress}"
                         IsIndeterminate="{Binding IsRunning}"
                         Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- Main Body Grid: Sidebar Navigation + Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Active Workspace -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,14,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- App Branding -->
                        <RowDefinition Height="*" />    <!-- Navigation Links -->
                    </Grid.RowDefinitions>

                    <!-- App Branding Header -->
                    <StackPanel Grid.Row="0" Margin="4,0,4,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Server24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bulk Switch" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Fleet Backup &amp; Discovery" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="28,-4,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedNavigationIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DesktopPulse24" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="Run &amp; Monitor" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Key24" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="Saved Credentials" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="Command Profiles" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ACTIVE WORKSPACE (PAGE HOST) -->
            <Grid Grid.Column="1" Margin="16,14,16,14">

                <!-- ============================================================== -->
                <!-- PAGE 0: RUN & MONITOR                                          -->
                <!-- ============================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" /> <!-- Configuration Panel -->
                        <ColumnDefinition Width="*" />   <!-- Monitor & Console Panel -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT CONFIGURATION COLUMN -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,14,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel>
                                <!-- Section 1: Target Devices -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Router24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Target Devices" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding TargetIpsCount, StringFormat='{}{0} IPs'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="IP Addresses (One per line):" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>

                                <!-- Native Multiline IP Input Box (No clear cross button, top-left aligned) -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                    <TextBox Text="{Binding TargetIps, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                             FontFamily="Consolas" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                             TextAlignment="Left" Padding="8,8"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Border>

                                <ui:Button Content="Import IP List from File..." Command="{Binding ImportDevicesCommand}"
                                           Appearance="Secondary" HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,14">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <Separator Margin="0,0,0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                                <!-- Section 2: Session Credentials -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="SSH Credentials" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Username:" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                <ui:TextBox Text="{Binding ActiveUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="admin / cisco" 
                                            ClearButtonEnabled="False" HorizontalContentAlignment="Left" TextAlignment="Left" Margin="0,0,0,8"/>

                                <TextBlock Text="Password:" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="ActivePwdBox" PasswordChar="*" Height="32" PasswordChanged="ActivePwdBox_PasswordChanged" Margin="0,0,0,8"/>

                                <TextBlock Text="Enable Secret (Optional):" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="ActiveSecretBox" PasswordChar="*" Height="32" PasswordChanged="ActiveSecretBox_PasswordChanged" Margin="0,0,0,10"/>

                                <CheckBox Content="Failover to saved credentials if needed" IsChecked="{Binding UseVaultAsFallback}" FontSize="11" Margin="0,0,0,14"/>

                                <Separator Margin="0,0,0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                                <!-- Section 3: Traversal & Concurrency -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Traversal &amp; Tuning" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox Content="Recursive CDP / LLDP Neighbor Crawl" IsChecked="{Binding EnableCdp}" Margin="0,0,0,4"/>
                                <TextBlock Text="• IP Phones &amp; ATAs automatically skipped" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="20,0,0,6"/>

                                <CheckBox Content="Include Discovered Access Points" IsChecked="{Binding IncludeAps}" Margin="20,0,0,8"
                                          IsEnabled="{Binding EnableCdp}"/>

                                <DockPanel LastChildFill="False" Margin="0,4,0,2">
                                    <TextBlock DockPanel.Dock="Left" Text="Worker Threads:" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MaxConcurrency, StringFormat='{}{0} threads'}" FontSize="11.5" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="30" Value="{Binding MaxConcurrency}" SmallChange="1" LargeChange="2" Margin="0,0,0,8"/>

                                <CheckBox Content="Write running-config to startup" IsChecked="{Binding WriteConfig}" Margin="0,0,0,14"/>

                                <Separator Margin="0,0,0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                                <!-- Section 4: Destination Folder -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Backup Destination" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding BackupDirectory, Mode=TwoWay}" IsReadOnly="True" FontSize="11" Margin="0,0,6,0"/>
                                    <ui:Button Grid.Column="1" Content="Browse" Command="{Binding BrowseBackupFolderCommand}" Appearance="Secondary" Height="32"/>
                                </Grid>

                                <!-- Section 5: Primary Action Buttons -->
                                <StackPanel Margin="0,4,0,0">
                                    <!-- Start Backup Button (Visible when NOT running) -->
                                    <ui:Button Content="Start Backup" Icon="{ui:SymbolIcon Play24}"
                                               Command="{Binding StartBackupCommand}" Appearance="Primary"
                                               Height="40" HorizontalAlignment="Stretch"
                                               Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                    <!-- Cancel Backup Button (Visible when running) -->
                                    <ui:Button Content="Cancel Backup" Icon="{ui:SymbolIcon Stop24}"
                                               Command="{Binding CancelBackupCommand}" Appearance="Danger"
                                               Height="40" HorizontalAlignment="Stretch"
                                               Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- RIGHT MONITOR & CONSOLE COLUMN -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Stat Summary Cards -->
                            <RowDefinition Height="Auto" /> <!-- Animated Progress Banner -->
                            <RowDefinition Height="3*" />    <!-- Device Live Status DataGrid -->
                            <RowDefinition Height="2*" />    <!-- Live Execution Console -->
                        </Grid.RowDefinitions>

                        <!-- Stat Cards Strip -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stat 1: Total -->
                            <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Total Devices" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalDevicesCount}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Stat 2: In Progress -->
                            <ui:Card Grid.Column="1" Margin="3,0,3,0" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="In Progress" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="●" Foreground="#4CC2FF" FontSize="10" Margin="6,0,0,0"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InProgressDevicesCount}" FontSize="22" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Stat 3: Completed -->
                            <ui:Card Grid.Column="2" Margin="3,0,3,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Completed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CompletedDevicesCount}" FontSize="22" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Stat 4: Failed -->
                            <ui:Card Grid.Column="3" Margin="6,0,0,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Failed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FailedDevicesCount}" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>
                        </Grid>

                        <!-- Animated Visual Progress Banner -->
                        <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <ui:SymbolIcon Symbol="DesktopCheckmark24" FontSize="14" Margin="0,0,8,0"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding RunningStatusSummary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </StackPanel>
                                </DockPanel>

                                <ProgressBar Grid.Row="1" Height="6" Minimum="0" Maximum="100" Value="{Binding OverallProgress}"
                                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                             Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderThickness="0"/>
                            </Grid>
                        </ui:Card>

                        <!-- Devices DataGrid with Animated Live Badges -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="180"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="100"/>
                                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/>
                                <DataGridTemplateColumn Header="Progress" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100" Height="6" BorderThickness="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Animated Progress Ring when device is InProgress -->
                                                <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,6,0" Foreground="#4CC2FF"
                                                                 Visibility="{Binding IsInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <!-- Checkmark icon when device is Completed -->
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#107C41" FontSize="14" Margin="0,0,6,0"
                                                               Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <!-- Dismiss icon when device is Failed -->
                                                <ui:SymbolIcon Symbol="DismissCircle24" Foreground="#C42B1C" FontSize="14" Margin="0,0,6,0"
                                                               Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusTextColor}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Live Console & Action Strip -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4,4,0,0" Padding="10,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="WindowConsole20" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Execution Logs &amp; Events" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="Open Folder" Command="{Binding OpenBackupFolderCommand}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Export ZIP" Command="{Binding ExportZipCommand}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Copy" Command="{Binding CopyLogsCommand}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                        <ui:Button Content="Clear" Command="{Binding ClearLogsCommand}" Appearance="Secondary" Height="26" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#181818" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,1,1">
                                <TextBox x:Name="ConsoleTextBox" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
                                         Background="Transparent" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                                         BorderThickness="0" Padding="8,8"
                                         TextChanged="ConsoleTextBox_TextChanged"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- PAGE 1: SAVED CREDENTIALS (OPTIONAL PRESETS)                   -->
                <!-- ============================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" /> <!-- Add Credential Form -->
                        <ColumnDefinition Width="*" />   <!-- Saved Credentials List -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Add Credential Form -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Margin="0,0,14,0" Padding="18"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Key24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Save Credential Preset" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Profile Name (Label):" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding NewCredProfileName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Core Switches, NOC Fallback"
                                        ClearButtonEnabled="False" HorizontalContentAlignment="Left" TextAlignment="Left" Margin="0,0,0,10"/>

                            <TextBlock Text="SSH Username:" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding NewCredUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="admin / netadmin"
                                        ClearButtonEnabled="False" HorizontalContentAlignment="Left" TextAlignment="Left" Margin="0,0,0,10"/>

                            <TextBlock Text="SSH Password:" FontSize="12" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="NewCredPwdBox" PasswordChar="*" Height="34" PasswordChanged="NewCredPwdBox_PasswordChanged" Margin="0,0,0,10"/>

                            <TextBlock Text="Enable Secret (Optional):" FontSize="12" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="NewCredSecretBox" PasswordChar="*" Height="34" PasswordChanged="NewCredSecretBox_PasswordChanged" Margin="0,0,0,16"/>

                            <ui:Button Content="Save Credential" Command="{Binding SaveNewCredentialCommand}"
                                       Appearance="Primary" HorizontalAlignment="Stretch" Height="38">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24" FontSize="16"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <TextBlock Text="Note: Storing credentials here is completely optional. Saved credentials can be applied to the active session with one click, or used as automatic failover."
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Saved Credentials Table -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Margin="0,0,0,12" Padding="14"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Saved Credentials Pool" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Manage pre-configured credentials to quickly apply them to your session or allow the backup engine to test them sequentially if the primary login fails."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StoredCredentials}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profile Name" Binding="{Binding Name}" Width="180" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="Secret Configured" Binding="{Binding Secret, TargetNullValue='No', FallbackValue='No'}" Width="130"/>
                                <DataGridTemplateColumn Header="Actions" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="Apply to Session" Command="{Binding DataContext.ApplyCredentialToActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                                <ui:Button Content="Delete" Command="{Binding DataContext.DeleteStoredCredentialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Appearance="Secondary" Height="26" Padding="8,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- PAGE 2: COMMAND PROFILES & CUSTOM CLI                          -->
                <!-- ============================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Cohesive Toolbar without weird center gaps -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Margin="0,0,0,12" Padding="14"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <DockPanel LastChildFill="False">
                            <!-- Left: Label, ComboBox, Count badge tightly grouped -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CLI Command Profile:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox SelectedIndex="{Binding SelectedProfileIndex, Mode=TwoWay}" Width="260" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Cisco Switch (IOS / IOS-XE)"/>
                                    <ComboBoxItem Content="Cisco Nexus Switch (NX-OS)"/>
                                    <ComboBoxItem Content="Custom CLI Command Script"/>
                                </ComboBox>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CommandCount, StringFormat='{}{0} Commands'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Right: Reset & Clear buttons -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Reset Template" Command="{Binding ResetProfileCommandsCommand}" Appearance="Secondary" Height="32" Margin="0,0,8,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="Clear" Command="{Binding ClearCommandsCommand}" Appearance="Secondary" Height="32">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Custom Commands Editor Area (Native TextBox, No cross button, top-left aligned, full stretch) -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CLI Commands to execute per target (One per line; lines starting with '!' are comments):"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBox Text="{Binding CustomCommandsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                         TextAlignment="Left" Padding="10,10"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
