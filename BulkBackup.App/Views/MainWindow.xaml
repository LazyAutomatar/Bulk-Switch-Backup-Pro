<ui:FluentWindow x:Class="BulkBackup.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BulkBackup.App.ViewModels"
        xmlns:conv="clr-namespace:BulkBackup.App.Converters"
        mc:Ignorable="d"
        Title="Bulk Switch Backup Pro"
        Height="840" Width="1380" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Title Bar -->
            <RowDefinition Height="*" />    <!-- Main Workspace -->
        </Grid.RowDefinitions>

        <!-- Window Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="Bulk Switch Backup Pro - Enterprise Fleet Automation" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border Background="#107C41" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock Text="C# Native Engine" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <Border Background="#2D2D30" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="DPAPI Vault Active" FontSize="11" Foreground="#9CDCFE"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Main Body Grid: Sidebar Navigation + Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Active Workspace -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,14,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- App Branding -->
                        <RowDefinition Height="*" />    <!-- Navigation Links -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Status -->
                    </Grid.RowDefinitions>

                    <!-- App Branding Header -->
                    <StackPanel Grid.Row="0" Margin="4,0,4,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Server24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bulk Switch" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Fleet Backup &amp; Discovery" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="28,-4,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedNavigationIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DesktopPulse24" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="Run &amp; Monitor" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Key24" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="Credential Vault" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="Command Profiles" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Bottom Sidebar Status Banner -->
                    <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Engine Status" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue='Idle', TargetNullValue='Idle'}" 
                                       FontSize="11.5" Foreground="#107C41" FontWeight="Bold" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="● Idle - Ready"/>
                                        <Setter Property="Foreground" Value="#107C41"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="● Running Backups..."/>
                                                <Setter Property="Foreground" Value="#0078D4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="v2.0 Native Edition" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ACTIVE WORKSPACE (PAGE HOST) -->
            <Grid Grid.Column="1" Margin="16,14,16,14">

                <!-- ============================================================== -->
                <!-- PAGE 0: RUN & MONITOR                                          -->
                <!-- ============================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" /> <!-- Configuration Controls Panel -->
                        <ColumnDefinition Width="*" />   <!-- Monitor & Console Panel -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT CONFIGURATION COLUMN -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Card 1: Target Devices -->
                            <ui:Card Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Router24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Target Devices" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding TargetIpsCount, StringFormat='{}{0} IPs'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="IP Addresses (One per line or seed IPs for CDP):" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding TargetIps, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" TextWrapping="Wrap" Height="84" FontFamily="Consolas" FontSize="12"
                                                PlaceholderText="192.168.1.1&#x0a;192.168.1.2&#x0a;10.0.0.1" Margin="0,0,0,8"
                                                VerticalScrollBarVisibility="Auto"/>

                                    <ui:Button Content="Import IP List from File..." Command="{Binding ImportDevicesCommand}"
                                               Appearance="Secondary" HorizontalAlignment="Stretch" Height="32">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </ui:Card>

                            <!-- Card 2: Authentication & Credentials -->
                            <ui:Card Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Session Authentication" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding StoredCredentials.Count, StringFormat='{}{0} in Vault'}" FontSize="11" Foreground="#4CC2FF"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="SSH Username:" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ui:TextBox Text="{Binding ActiveUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="admin / cisco" Margin="0,0,0,8"/>

                                    <TextBlock Text="SSH Password:" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="ActivePwdBox" PasswordChar="*" Height="32" PasswordChanged="ActivePwdBox_PasswordChanged" Margin="0,0,0,8"/>

                                    <TextBlock Text="Enable Secret (Optional):" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="ActiveSecretBox" PasswordChar="*" Height="32" PasswordChanged="ActiveSecretBox_PasswordChanged" Margin="0,0,0,8"/>

                                    <TextBlock Text="Vault failover: All DPAPI stored credentials will be automatically tried if this login fails." 
                                               FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Card 3: Discovery & Concurrency -->
                            <ui:Card Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Discovery &amp; Engine Tuning" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- CDP / LLDP Traversal -->
                                    <CheckBox Content="Recursive CDP / LLDP Neighbor Crawl" IsChecked="{Binding EnableCdp}" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Auto-skips Cisco IP Phones (SEP*, 79xx, 88xx, ATA)" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="20,0,0,6"/>

                                    <CheckBox Content="Include Discovered Access Points" IsChecked="{Binding IncludeAps}" Margin="20,0,0,8"
                                              IsEnabled="{Binding EnableCdp}"/>

                                    <!-- Concurrency Slider -->
                                    <Grid Margin="0,4,0,2">
                                        <TextBlock Text="Worker Concurrency Threads:" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding MaxConcurrency, StringFormat='{}{0} threads'}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="20" Value="{Binding MaxConcurrency}" SmallChange="1" LargeChange="2" Margin="0,0,0,8"/>

                                    <!-- Save Config Option -->
                                    <CheckBox Content="Write running-config to startup prior to backup" IsChecked="{Binding WriteConfig}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Card 4: Backup Destination -->
                            <ui:Card Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Backup Destination" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding BackupDirectory, Mode=TwoWay}" IsReadOnly="True" FontSize="11" Margin="0,0,6,0"/>
                                        <ui:Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseBackupFolderCommand}" Appearance="Secondary" Height="32"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Primary Action Buttons Row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0" Content="Start Backup" Command="{Binding StartBackupCommand}"
                                           Appearance="Primary" Height="40" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                           IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Play24" FontSize="16"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Grid.Column="1" Content="Cancel" Command="{Binding CancelBackupCommand}"
                                           Appearance="Secondary" Height="40" HorizontalAlignment="Stretch" Margin="6,0,0,0"
                                           IsEnabled="{Binding IsRunning}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Stop24" FontSize="16"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT MONITOR & CONSOLE COLUMN -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Stat Summary Cards -->
                            <RowDefinition Height="Auto" /> <!-- Overall Progress Bar -->
                            <RowDefinition Height="3*" />    <!-- Device Live Status DataGrid -->
                            <RowDefinition Height="2*" />    <!-- Live Execution Console -->
                        </Grid.RowDefinitions>

                        <!-- Stat Cards Strip -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stat 1: Total -->
                            <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Total Devices" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalDevicesCount}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Stat 2: In Progress -->
                            <ui:Card Grid.Column="1" Margin="3,0,3,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="In Progress" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InProgressDevicesCount}" FontSize="22" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Stat 3: Completed -->
                            <ui:Card Grid.Column="2" Margin="3,0,3,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Completed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CompletedDevicesCount}" FontSize="22" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Stat 4: Failed -->
                            <ui:Card Grid.Column="3" Margin="6,0,0,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Failed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FailedDevicesCount}" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:Card>
                        </Grid>

                        <!-- Overall Progress Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding OverallProgress}"
                                         Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                         Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderThickness="0"/>
                        </Grid>

                        <!-- Devices DataGrid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="180"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="100"/>
                                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/>
                                <DataGridTemplateColumn Header="Progress" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100" Height="6" BorderThickness="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0}%'}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusTextColor}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Live Console & Action Strip -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4,4,0,0" Padding="10,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="WindowConsole20" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Execution Logs &amp; Events" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="Open Folder" Command="{Binding OpenBackupFolderCommand}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Export ZIP" Command="{Binding ExportZipCommand}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Copy" Command="{Binding CopyLogsCommand}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                        <ui:Button Content="Clear" Command="{Binding ClearLogsCommand}" Appearance="Secondary" Height="26" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ui:TextBox Grid.Row="1" x:Name="ConsoleTextBox" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True"
                                        TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
                                        Background="#181818" Foreground="#D4D4D4" BorderThickness="1,0,1,1"
                                        TextChanged="ConsoleTextBox_TextChanged"
                                        VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- PAGE 1: CREDENTIAL VAULT (DPAPI)                               -->
                <!-- ============================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" /> <!-- Add Credential Form -->
                        <ColumnDefinition Width="*" />   <!-- Saved Credentials List -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Add Credential Form -->
                    <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Key24" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Store Credential in DPAPI Vault" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Profile Name (Label):" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding NewCredProfileName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Core Switches, NOC Fallback" Margin="0,0,0,10"/>

                            <TextBlock Text="SSH Username:" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding NewCredUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="admin / netadmin" Margin="0,0,0,10"/>

                            <TextBlock Text="SSH Password:" FontSize="12" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="NewCredPwdBox" PasswordChar="*" Height="34" PasswordChanged="NewCredPwdBox_PasswordChanged" Margin="0,0,0,10"/>

                            <TextBlock Text="Enable Secret (Optional):" FontSize="12" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="NewCredSecretBox" PasswordChar="*" Height="34" PasswordChanged="NewCredSecretBox_PasswordChanged" Margin="0,0,0,16"/>

                            <ui:Button Content="Save Credential to Windows DPAPI" Command="{Binding SaveNewCredentialCommand}"
                                       Appearance="Primary" HorizontalAlignment="Stretch" Height="38">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <TextBlock Text="Security Note: Credentials stored here are strongly encrypted with the Windows Data Protection API (DPAPI) tied to your current user account. Plaintext passwords are never saved to disk."
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </ui:Card>

                    <!-- Right Card: Saved Credentials Table -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Saved Credentials Pool (Sequential Failover)" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="During bulk backup runs, if connection or authentication fails on a switch using active credentials, the engine automatically attempts each vault credential in sequence until successful."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StoredCredentials}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profile Name" Binding="{Binding Name}" Width="180" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="Secret Configured" Binding="{Binding Secret, TargetNullValue='No', FallbackValue='No'}" Width="130"/>
                                <DataGridTemplateColumn Header="Actions" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="Apply to Session" Command="{Binding DataContext.ApplyCredentialToActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                                <ui:Button Content="Delete" Command="{Binding DataContext.DeleteStoredCredentialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Appearance="Secondary" Height="26" Padding="8,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- PAGE 2: COMMAND PROFILES & CUSTOM CLI                          -->
                <!-- ============================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Profile Selector & Action Controls -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLI Command Profile:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedProfileIndex, Mode=TwoWay}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Cisco Switch (IOS / IOS-XE)"/>
                                <ComboBoxItem Content="Cisco Nexus Switch (NX-OS)"/>
                                <ComboBoxItem Content="Custom CLI Command Script"/>
                            </ComboBox>

                            <Border Grid.Column="2" HorizontalAlignment="Left" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" Margin="14,0,0,0">
                                <TextBlock Text="{Binding CommandCount, StringFormat='{}{0} Commands Configured'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Reset to Template" Command="{Binding ResetProfileCommandsCommand}" Appearance="Secondary" Height="32" Margin="0,0,6,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="Clear Commands" Command="{Binding ClearCommandsCommand}" Appearance="Secondary" Height="32">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Custom Commands Editor Area -->
                    <ui:Card Grid.Row="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Execute CLI Commands (One command per line; lines starting with '!' are treated as comments):"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                            <ui:TextBox Grid.Row="1" Text="{Binding CustomCommandsText, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
